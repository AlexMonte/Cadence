#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

FRONTEND_DIR="cadence_frontend"

usage() {
  cat <<'EOF'
Usage: ./dev [command]

Commands:
  check    Build frontend assets, run Rust + wasm check gates, and run e2e smoke tests. (default)
  build    Build frontend assets into cadence_frontend/dist/public.
  rust     Run cadence/cadence_frontend Rust + wasm check gates.
  e2e      Run frontend Playwright smoke tests against the real web runtime.
  fmt      Format all Rust code (cargo fmt).
  clippy   Run clippy lints across the workspace.
  help     Show this help text.

Web deployment note:
  Production COOP/COEP requirements are documented in cadence/docs/web_runtime_deployment.md.
EOF
}

announce() {
  printf '\n==> %s\n' "$1"
}

build_frontend() {
  announce "Bundling frontend dist"
  npm --prefix "$FRONTEND_DIR" run build
}

run_rust_checks() {
  announce "Checking cadence backend test targets"
  cargo check -p cadence --tests

  announce "Checking cadence desktop frontend"
  cargo check -p cadence_frontend --features desktop

  announce "Checking cadence web frontend"
  cargo check -p cadence_frontend --features web

  announce "Checking cadence wasm backend"
  cargo check -p cadence --target wasm32-unknown-unknown

  announce "Checking cadence wasm frontend"
  cargo check -p cadence_frontend --target wasm32-unknown-unknown --features web
}

run_e2e() {
  announce "Running frontend smoke tests"
  printf 'Production COOP/COEP headers: cadence/docs/web_runtime_deployment.md\n'
  npm --prefix "$FRONTEND_DIR" run test:e2e
}

run_fmt() {
  announce "Formatting Rust code"
  cargo fmt --all
}

run_clippy() {
  announce "Running clippy on workspace"
  cargo clippy --workspace --all-targets -- -D warnings
}

command="${1:-check}"

case "$command" in
  check)
    build_frontend
    run_rust_checks
    run_e2e
    ;;
  build)
    build_frontend
    ;;
  rust)
    run_rust_checks
    ;;
  e2e)
    run_e2e
    ;;
  fmt)
    run_fmt
    ;;
  clippy)
    run_clippy
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 1
    ;;
esac
