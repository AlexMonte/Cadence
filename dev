#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

FRONTEND_DIR="cadence_frontend"

usage() {
  cat <<'EOF'
Usage: ./dev [command]

Commands:
  check    Build frontend assets, run Rust tests, check the desktop package, and run e2e smoke tests. (default)
  build    Build frontend assets into cadence_frontend/dist/public.
  rust     Run backend/frontend Rust tests and check the desktop package.
  e2e      Run frontend Playwright smoke tests.
  fmt      Format all Rust code (cargo fmt).
  clippy   Run clippy lints across the workspace.
  help     Show this help text.
EOF
}

announce() {
  printf '\n==> %s\n' "$1"
}

build_frontend() {
  announce "Bundling frontend dist"
  npm --prefix "$FRONTEND_DIR" run build
}

run_rust_checks() {
  announce "Running backend library tests"
  cargo test -p cadence --lib -- --nocapture

  announce "Running frontend Rust tests"
  cargo test -p cadence_frontend -- --nocapture

  announce "Checking desktop package"
  cargo check -p cadence
}

run_e2e() {
  announce "Running frontend smoke tests"
  npm --prefix "$FRONTEND_DIR" run test:e2e
}

run_fmt() {
  announce "Formatting Rust code"
  cargo fmt --all
}

run_clippy() {
  announce "Running clippy on workspace"
  cargo clippy --workspace --all-targets -- -D warnings
}

command="${1:-check}"

case "$command" in
  check)
    build_frontend
    run_rust_checks
    run_e2e
    ;;
  build)
    build_frontend
    ;;
  rust)
    run_rust_checks
    ;;
  e2e)
    run_e2e
    ;;
  fmt)
    run_fmt
    ;;
  clippy)
    run_clippy
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 1
    ;;
esac
