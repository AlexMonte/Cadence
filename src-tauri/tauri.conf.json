{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GrooveAtlas",
  "version": "0.1.0",
  "identifier": "cc.grooveatlas.app",
  "build": {
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "GrooveAtlas",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
